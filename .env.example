# ─── Required ────────────────────────────────────────────────────────────────

# 4-digit PIN for the app gate — set a strong value in production
WS_PIN=0000

# Secret used to sign session cookies — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# ─── AI ──────────────────────────────────────────────────────────────────────

# Anthropic API key — enables Jarvis AI assistant and narrative generation
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Intelligence stations (optional) ────────────────────────────────────────

# Neon Postgres — required for ForecastStation signal history
DATABASE_URL=postgres://user:pass@host/dbname

# Mapbox — required for PreCon Omni geocoding and parcel data
MAPBOX_TOKEN=your-mapbox-token

# ─── Frontend env (Vite VITE_ prefix) ────────────────────────────────────────

# Default dispatch lat/lng if geolocation is denied (defaults to Richmond, VA)
VITE_DISPATCH_LAT=37.5407
VITE_DISPATCH_LON=-77.4360

# Backend API base URL (used in production builds)
VITE_API_BASE_URL=http://127.0.0.1:8010
