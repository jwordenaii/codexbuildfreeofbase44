{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jwordenai/schemas/truth.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market",
    "entity",
    "location",
    "services",
    "branding",
    "sla_policy_ref"
  ],
  "properties": {
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "city",
        "state",
        "timezone"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "timezone": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "legalName",
        "phone",
        "naics"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "minLength": 7
        },
        "naics": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street",
        "city",
        "state",
        "zip",
        "serviceArea"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        },
        "serviceArea": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ctaPath": {
            "type": "string"
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor",
        "accentColor",
        "fontStack"
      ],
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontStack": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "sla_policy_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
