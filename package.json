  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@netlify/functions": "^5.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
