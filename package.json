{
  "name": "jworden-luxury-paving",
  "description": "J. Worden Luxury Paving - Professional Asphalt Paving and Maintenance across Virginia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs && node scripts/submit-indexnow.mjs && node scripts/submit-google-search-console.mjs",
    "ai:blog-factory": "node scripts/ai-blog-factory.mjs",
    "ai:authority": "node scripts/ai-authority-factory.mjs",
    "ai:authority:force": "node scripts/ai-authority-factory.mjs --force",
    "ai:authority:dry-run": "node scripts/ai-authority-factory.mjs --dry-run",
    "content:blog-writer": "node scripts/factory-blog-writer.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs --force",
    "gsc:submit": "node scripts/submit-google-search-console.mjs --force",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "ai:build-pages": "node scripts/ai-page-factory.mjs",
    "ai:site-studio": "node scripts/site-blueprint-studio.mjs",
    "factory:add-site": "node scripts/add-site-to-factory.mjs",
    "factory:launch-pack": "node scripts/factory-launch-pack.mjs",
    "factory:create-standalone-repo": "node scripts/create-standalone-site-repo.mjs",
    "factory:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-client.ps1",
    "ops:preflight": "powershell -ExecutionPolicy Bypass -File scripts/repo-preflight.ps1",
    "ops:secrets": "powershell -ExecutionPolicy Bypass -File scripts/set-operational-secrets.ps1",
    "ops:seo-guard": "powershell -ExecutionPolicy Bypass -File scripts/seo-guardrails.ps1",
    "ops:seo-self-heal": "powershell -ExecutionPolicy Bypass -File scripts/seo-self-heal.ps1 -UpdateCoreRoutes",
    "guard:public-core": "node scripts/verify-public-core-boundary.mjs",
    "guard:site-isolation": "node scripts/verify-site-isolation.mjs",
    "guard:seo-readiness": "node scripts/verify-seo-readiness.mjs",
    "guard:sitemaps": "node scripts/verify-sitemap-safety.mjs",
    "guard:site-safety": "npm run guard:public-core && npm run guard:site-isolation && npm run guard:sitemaps",
    "ops:seo-kit": "node scripts/create-seo-growth-kit.mjs",
    "ops:pricing": "node scripts/calc-builder-pricing.mjs",
    "ops:state-reach": "node scripts/state-reach-report.mjs",
    "ops:tech-radar": "node scripts/ai-tech-radar.mjs",
    "ops:tech-radar:diff": "node scripts/ai-tech-radar.mjs --diff-only",
    "ops:logic-snapshot": "node scripts/logic-preserve-snapshot.mjs",
    "ops:clean-house": "node scripts/clean-house-report.mjs",
    "ops:legal-advisory": "node scripts/legal-advisory-change-report.mjs",
    "ops:legal-advisory:refresh-baseline": "node scripts/legal-advisory-change-report.mjs --refresh-baseline",
    "ops:legal-advisory:update-baseline": "node scripts/legal-advisory-change-report.mjs --update-baseline",
    "ops:reliability-synthetic": "node scripts/reliability-synthetic-monitor.mjs",
    "ops:phase2": "npm run ops:logic-snapshot && npm run ops:clean-house",
    "sitemap:all-states": "node scripts/generate-sitemap.mjs --all-states",
    "ops:live-check": "powershell -ExecutionPolicy Bypass -File scripts/live-deploy-check.ps1",
    "mrworden:cli": "powershell -ExecutionPolicy Bypass -File scripts/mrworden-cli.ps1",
    "mrworden:batch": "powershell -ExecutionPolicy Bypass -File scripts/mrworden-cli.ps1 -Action batch-qualify",
    "media:ingest": "powershell -ExecutionPolicy Bypass -File scripts/media-ingest-cli.ps1",
    "media:doctor": "powershell -ExecutionPolicy Bypass -File scripts/media-ingest-cli.ps1 -Action check-setup",
    "media:dropbox": "powershell -ExecutionPolicy Bypass -File scripts/media-ingest-cli.ps1 -Action pull-dropbox",
    "media:gphotos": "powershell -ExecutionPolicy Bypass -File scripts/media-ingest-cli.ps1 -Action pull-google-photos",
    "media:gdrive": "powershell -ExecutionPolicy Bypass -File scripts/media-ingest-cli.ps1 -Action pull-google-drive",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "echo \"No frontend unit tests configured\"",
    "test:e2e": "npx playwright test"
  },
