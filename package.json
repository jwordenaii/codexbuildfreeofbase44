    "@tremor/react": "^3.18.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "jspdf": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
